# Copy to .env in this directory: cp .env.example .env
# Docker Compose loads .env automatically for variable substitution.
#
# If you change MONGO_INITDB_ROOT_USERNAME or MONGO_INITDB_ROOT_PASSWORD,
# update SPRING_DATA_MONGODB_URI so the credentials match (same user/password in the URI).

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=secret
SPRING_DATA_MONGODB_URI=mongodb://root:secret@mongodb:27017/daily_agent?authSource=admin
