# Copy to .env: cp .env.example .env
# Docker Compose substitutes these into docker-compose.yml for the MongoDB service and the app.

# MongoDB root user (container init + Spring app auth). Single source for credentials.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=secret

# Optional: override Spring connection when running the app outside Compose (defaults in application.properties).
# SPRING_MONGODB_HOST=localhost
# SPRING_MONGODB_PORT=27017
# SPRING_MONGODB_DATABASE=daily_agent
# SPRING_MONGODB_AUTHENTICATION_DATABASE=admin

# Optional: full connection URI (overrides discrete spring.mongodb.*). Use for Atlas, TLS, or extra driver options.
# SPRING_MONGODB_URI=mongodb+srv://...

# World News API (https://worldnewsapi.com). Required for scheduled ingest into news_items.
# WORLD_NEWS_API_KEY=your-api-key-here
# Optional: set false to disable the scheduler (default true when unset in Compose).
# WORLD_NEWS_INGEST_ENABLED=true
# Optional: page size per request (clamped to 1–100 in code).
# WORLD_NEWS_PAGE_SIZE=25
# Optional: language filter passed to search-news (default en). Use en to avoid Hindi etc.
# WORLD_NEWS_LANGUAGE=en
# Optional: search-news "text" only when MongoDB collection world_news_keywords is empty.
# Prefer storing rows { keyword, operator: OR|NOT, sort_order } and restarting; see application.properties.
# WORLD_NEWS_TEXT=technology
# Optional: source country ISO code (search-news "source-country", e.g. us, gb).
# WORLD_NEWS_SOURCE_COUNTRY=us
# Optional: category (e.g. business, technology — see API docs).
# WORLD_NEWS_CATEGORY=business
# Optional: scheduler delays in ms (defaults: 60000 initial, 3600000 = 1h between runs).
# WORLD_NEWS_INGEST_INITIAL_DELAY_MS=60000
# WORLD_NEWS_INGEST_FIXED_DELAY_MS=3600000

# xAI Grok API (https://docs.x.ai — create key in console). Required for POST /api/news/analyze.
# XAI_API_KEY=your-xai-api-key-here
# Optional overrides (defaults match application.properties).
# XAI_MODEL=grok-4.20-reasoning
# XAI_BASE_URL=https://api.x.ai
# XAI_BATCH_SIZE=10
# XAI_EXCERPT_MAX_CHARS=2000
# Optional: default text for the final analysis/briefing step only (not per-article summaries).
# Used when POST /api/news/analyze omits briefingPrompt. Per-request body still wins.
# Matches defaultBriefingPrompt in classpath prompts/news-analyze.yaml when unset.
# XAI_BRIEFING_PROMPT=Give a briefing on the summarized news relevant to our stock positions ONLY below. Analyze how the themes and events may affect our current stock positions (symbols and quantities are listed under "Our current stock positions"). Tie commentary to our holdings only when the news summaries reasonably support it. Do not invent facts, stories, or positions; if you want to be speculative, you are allowed to but say so clearly.
# Optional: put exception detail in HTTP error JSON (never | always). Use always while debugging 502s.
# SERVER_ERROR_INCLUDE_MESSAGE=always

# Scheduled daily analyze + Mongo archive news_daily_briefings (default 08:00 in zone).
# NEWS_DAILY_BRIEFING_ENABLED=true
# NEWS_DAILY_BRIEFING_CRON=0 0 8 * * *
# NEWS_DAILY_BRIEFING_ZONE_ID=Asia/Hong_Kong
# Anchor date = today in zone minus this many calendar days (default 7 in application.properties / compose).
# NEWS_DAILY_BRIEFING_DAY_OFFSET=7
# Half-open window length from anchor: [start, start+N). Clamped to 1..7 (analyze API max).
# NEWS_DAILY_BRIEFING_WINDOW_DAYS=1

# Scheduled purge of MongoDB news_items older than retention-days (published_date < today in zone minus N days).
# NEWS_ITEM_RETENTION_ENABLED=true
# NEWS_ITEM_RETENTION_CRON=0 0 3 * * *
# NEWS_ITEM_RETENTION_ZONE_ID=Asia/Hong_Kong
# NEWS_ITEM_RETENTION_RETENTION_DAYS=90

# scripts/run-daily-news-briefing.sh — Compose does not load these; export or: set -a && source .env && set +a && ./scripts/run-daily-news-briefing.sh
# BASE_URL=http://localhost:8080
# TIME_ZONE=Asia/Hong_Kong
# DAY_OFFSET=7
# WINDOW_DAYS=1
# DAY=2026-04-10
# BRIEFING_PROMPT=…same final-analysis text as XAI_BRIEFING_PROMPT / prompts/news-analyze.yaml default; script default matches the API if unset.