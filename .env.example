# Copy to .env: cp .env.example .env
# Docker Compose substitutes these into docker-compose.yml for the MongoDB service and the app.

# MongoDB root user (container init + Spring app auth). Single source for credentials.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=secret

# Optional: override Spring connection when running the app outside Compose (defaults in application.properties).
# SPRING_MONGODB_HOST=localhost
# SPRING_MONGODB_PORT=27017
# SPRING_MONGODB_DATABASE=daily_agent
# SPRING_MONGODB_AUTHENTICATION_DATABASE=admin

# Optional: full connection URI (overrides discrete spring.mongodb.*). Use for Atlas, TLS, or extra driver options.
# SPRING_MONGODB_URI=mongodb+srv://...

WORLD_NEWS_API_KEY=6755d73555194c26965258d9c90736e5