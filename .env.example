# Copy to .env: cp .env.example .env
# Docker Compose substitutes these into docker-compose.yml for the MongoDB service and the app.

# MongoDB root user (container init + Spring app auth). Single source for credentials.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=secret

# Optional: override Spring connection when running the app outside Compose (defaults in application.properties).
# SPRING_MONGODB_HOST=localhost
# SPRING_MONGODB_PORT=27017
# SPRING_MONGODB_DATABASE=daily_agent
# SPRING_MONGODB_AUTHENTICATION_DATABASE=admin

# Optional: full connection URI (overrides discrete spring.mongodb.*). Use for Atlas, TLS, or extra driver options.
# SPRING_MONGODB_URI=mongodb+srv://...

# World News API (https://worldnewsapi.com). Required for scheduled ingest into news_items.
# WORLD_NEWS_API_KEY=your-api-key-here
# Optional: set false to disable the scheduler (default true when unset in Compose).
# WORLD_NEWS_INGEST_ENABLED=true
# Optional: page size per request (clamped to 1–100 in code).
# WORLD_NEWS_PAGE_SIZE=25
# Optional: language filter passed to search-news (default en). Use en to avoid Hindi etc.
# WORLD_NEWS_LANGUAGE=en
# Optional: search-news "text" only when MongoDB collection world_news_keywords is empty.
# Prefer storing rows { keyword, operator: OR|NOT, sort_order } and restarting; see application.properties.
# WORLD_NEWS_TEXT=technology
# Optional: source country ISO code (search-news "source-country", e.g. us, gb).
# WORLD_NEWS_SOURCE_COUNTRY=us
# Optional: category (e.g. business, technology — see API docs).
# WORLD_NEWS_CATEGORY=business
# Optional: scheduler delays in ms (defaults: 60000 initial, 3600000 = 1h between runs).
# WORLD_NEWS_INGEST_INITIAL_DELAY_MS=60000
# WORLD_NEWS_INGEST_FIXED_DELAY_MS=3600000

# xAI Grok API (https://docs.x.ai — create key in console). Used when you add Grok HTTP client code; optional until then.
# XAI_API_KEY=your-xai-api-key-here